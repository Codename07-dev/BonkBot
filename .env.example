# ---- Required ----
# Token from @BotFather (create a NEW bot for UnkilBonker)
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token

# Your Telegram user id (gives you full control everywhere). Optional.
# Find it by messaging @userinfobot.
OWNER_ID=

# Comma-separated ids of other sudo users (optional)
SUDO_IDS=

# ---- Optional: AI channel rewriter ----
# If these are set, every new post in CHANNEL_ID gets AI-rewritten.
CHANNEL_ID=
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
REWRITE_STYLE=engaging, professional, and easy to read, with tasteful emoji section headers and clean formatting

# ---- Hosting (Render/Railway) ----
# Set to your service URL on Render, e.g. https://unkilbonker.onrender.com
# Leave empty for local runs (polling mode).
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- Storage ----
# SQLite file location. Note: Render's free disk is wiped on redeploy,
# so warns/notes/filters persist between restarts but reset on new deploys.
DB_PATH=unkilbonker.db
